package io.github.robertomike.super_controller.units

import io.github.robertomike.super_controller.annotations.SuperControllerOpenApi
import io.github.robertomike.super_controller.controllers.SuperController
import io.github.robertomike.super_controller.controllers.markers.BulkOperationsMarker
import io.github.robertomike.super_controller.controllers.markers.SoftDeletableMarker
import io.github.robertomike.super_controller.models.SoftDeletableEntity
import io.github.robertomike.super_controller.openapi.OpenApiConfig
import io.github.robertomike.super_controller.openapi.OpenApiProperties
import io.github.robertomike.super_controller.requests.Request
import io.github.robertomike.super_controller.services.SuperService
import io.github.robertomike.super_controller.versioning.ApiVersion
import io.swagger.v3.oas.models.OpenAPI
import io.swagger.v3.oas.models.Operation
import io.swagger.v3.oas.models.PathItem
import io.swagger.v3.oas.models.Paths
import io.swagger.v3.oas.models.media.Schema
import io.swagger.v3.oas.models.parameters.Parameter
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.BeforeEach
import java.time.LocalDateTime
import kotlin.test.*

/**
 * Unit tests for OpenAPI configuration and customization.
 * Tests cover CRUD operations, bulk operations, soft delete operations,
 * versioning, deprecation, and annotation handling.
 */
class OpenApiConfigTest {

    private lateinit var config: OpenApiConfig
    private lateinit var properties: OpenApiProperties
    private lateinit var openAPI: OpenAPI

    // Mock entities for testing
    class TestEntity : SoftDeletableEntity {
        override var deletedAt: LocalDateTime? = null
    }
    
    class TestRequest : Request
    class TestUpdateRequest : Request

    // Mock service for testing
    class TestService : io.github.robertomike.super_controller.services.interfaces.BasicService<TestEntity, org.springframework.data.domain.Page<TestEntity>, Long, Request, Request, Unit> {
        override fun index(page: org.springframework.data.domain.PageRequest, params: Map<String, String>): org.springframework.data.domain.Page<TestEntity> = throw NotImplementedError()
        override fun store(request: Request): TestEntity = throw NotImplementedError()
        override fun show(model: TestEntity): TestEntity = model
        override fun update(model: TestEntity, request: Request): TestEntity = model
        override fun delete(model: TestEntity) = Unit
        override fun findById(id: Long): TestEntity = throw NotImplementedError()
    }

    // Basic controller without markers
    open class BasicTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ) {
        init {
            path = "users"
        }
    }

    // Controller with BulkOperations marker
    open class BulkTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ),
        BulkOperationsMarker<TestEntity, Long, TestRequest, TestUpdateRequest> {
        init {
            path = "products"
        }
    }

    // Controller with SoftDeletable marker
    open class SoftDeletableTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ),
        SoftDeletableMarker<TestEntity, Long> {
        init {
            path = "orders"
        }
    }

    // Controller with both markers
    open class FullFeaturedTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ),
        BulkOperationsMarker<TestEntity, Long, TestRequest, TestUpdateRequest>,
        SoftDeletableMarker<TestEntity, Long> {
        init {
            path = "items"
        }
    }

    // Controller with custom tags via annotation
    @SuperControllerOpenApi(
        summary = "Custom API",
        description = "Custom description for testing",
        tags = ["CustomTag", "AnotherTag"]
    )
    open class AnnotatedTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ) {
        init {
            path = "annotated"
        }
    }

    // Versioned controller
    @ApiVersion(value = "v1")
    open class VersionedTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ) {
        init {
            path = "versioned"
        }
    }

    // Deprecated versioned controller
    @ApiVersion(
        value = "v1",
        deprecated = true,
        sunset = "2026-12-31",
        documentationUrl = "https://docs.example.com/migration"
    )
    open class DeprecatedTestController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
        service = TestService(),
        needAuthorization = false,
        basePackage = "io.github.robertomike.super_controller"
    ) {
        init {
            path = "deprecated"
        }
    }

    @BeforeEach
    fun setup() {
        config = OpenApiConfig()
        properties = OpenApiProperties(
            enabled = true,
            title = "Test API",
            description = "Test Description",
            version = "1.0.0"
        )
        openAPI = config.customOpenAPI(properties)
    }

    @Test
    fun `customOpenAPI creates OpenAPI with correct properties`() {
        assertNotNull(openAPI)
        assertEquals("Test API", openAPI.info.title)
        assertEquals("Test Description", openAPI.info.description)
        assertEquals("1.0.0", openAPI.info.version)
        assertNotNull(openAPI.servers)
        assertFalse(openAPI.servers.isEmpty())
        assertEquals("/", openAPI.servers[0].url)
    }

    @Test
    fun `customOpenAPI uses default properties when not specified`() {
        val defaultProps = OpenApiProperties()
        val defaultOpenAPI = config.customOpenAPI(defaultProps)
        
        assertEquals("API Documentation", defaultOpenAPI.info.title)
        assertEquals("RESTful API built with Super-Controller", defaultOpenAPI.info.description)
        assertEquals("1.0.0", defaultOpenAPI.info.version)
    }

    @Test
    fun `OpenApiProperties has correct defaults`() {
        val props = OpenApiProperties()
        assertEquals(false, props.enabled)
        assertEquals("API Documentation", props.title)
        assertEquals("RESTful API built with Super-Controller", props.description)
        assertEquals("1.0.0", props.version)
        assertTrue(props.servers.isEmpty())
    }

    @Test
    fun `superControllerOpenApiCustomizer can be created with empty controller list`() {
        val customizer = config.superControllerOpenApiCustomizer(emptyList())
        assertNotNull(customizer)
    }

    @Test
    fun `pagination parameters are added to GET operations`() {
        // Create a mock OpenAPI with paths
        val paths = Paths()
        val pathItem = PathItem().get(Operation().summary("List"))
        paths.addPathItem("/test", pathItem)
        openAPI.paths = paths
        
        // Get the customizer
        val controllers = listOf<SuperController<*, *, *, *>>()
        val customizer = config.superControllerOpenApiCustomizer(controllers)
        
        // Apply customization (won't do much with empty controller list, but shouldn't fail)
        customizer.customise(openAPI)
        
        // Verify the operation still exists
        assertNotNull(openAPI.paths["/test"]?.get)
    }

    @Test
    fun `pagination parameters are not duplicated`() {
        val operation = Operation()
        val pageParam = io.swagger.v3.oas.models.parameters.Parameter()
            .name("page")
            .`in`("query")
        operation.addParametersItem(pageParam)
        
        // Add pagination - should not duplicate the page parameter
        val params = operation.parameters ?: mutableListOf()
        val existingNames = params.map { it.name }.toSet()
        assertTrue(existingNames.contains("page"))
    }

    @Test
    fun `operation IDs are prefixed with version when ApiVersion is present`() {
        // This is tested implicitly through the enhanceCrudOperations method
        // The method is private, so we test it through the public interface
        val operation = Operation().operationId("testOperation")
        assertNotNull(operation.operationId)
    }

    @Test
    fun `deprecated operations are marked correctly`() {
        val operation = Operation().deprecated(true)
        assertTrue(operation.deprecated)
    }

    @Test
    fun `CRUD operations have correct descriptions`() {
        // Create operations with basic summaries
        val indexOp = Operation().summary("List").description("Retrieve a list")
        val storeOp = Operation().summary("Create").description("Create a new resource")
        val showOp = Operation().summary("Get").description("Retrieve a single resource")
        val updateOp = Operation().summary("Update").description("Update an existing resource")
        val deleteOp = Operation().summary("Delete").description("Delete a resource")
        
        assertNotNull(indexOp.summary)
        assertNotNull(storeOp.summary)
        assertNotNull(showOp.summary)
        assertNotNull(updateOp.summary)
        assertNotNull(deleteOp.summary)
    }

    @Test
    fun `bulk operations have correct descriptions`() {
        val bulkCreateOp = Operation().summary("Bulk create")
        val bulkUpdateOp = Operation().summary("Bulk update")
        val bulkDeleteOp = Operation().summary("Bulk delete")
        
        assertTrue(bulkCreateOp.summary.contains("Bulk"))
        assertTrue(bulkUpdateOp.summary.contains("Bulk"))
        assertTrue(bulkDeleteOp.summary.contains("Bulk"))
    }

    @Test
    fun `soft delete operations have correct descriptions`() {
        val softDeleteOp = Operation().summary("Soft delete").description("Soft delete a resource")
        val restoreOp = Operation().summary("Restore").description("Restore a soft-deleted resource")
        val forceDeleteOp = Operation().summary("Force delete").description("Permanently delete a resource")
        
        assertTrue(softDeleteOp.description?.contains("Soft delete") ?: false)
        assertTrue(restoreOp.description?.contains("Restore") ?: false)
        assertTrue(forceDeleteOp.description?.contains("Permanently") ?: false)
    }

    @Test
    fun `server configuration can be customized`() {
        val propsWithServers = OpenApiProperties(
            enabled = true,
            servers = listOf(
                OpenApiProperties.Server(url = "https://api.example.com", description = "Production"),
                OpenApiProperties.Server(url = "https://staging.example.com", description = "Staging")
            )
        )
        
        assertEquals(2, propsWithServers.servers.size)
        assertEquals("https://api.example.com", propsWithServers.servers[0].url)
        assertEquals("Production", propsWithServers.servers[0].description)
    }

    @Test
    fun `pagination parameters have correct schema types`() {
        val openAPI = OpenAPI()
        val paths = Paths()
        val pathItem = PathItem()
        val getOp = Operation().summary("List").description("Retrieve a list")
        pathItem.get = getOp
        val postOp = Operation().summary("Create").description("Create a new resource")
        pathItem.post = postOp
        paths.addPathItem("/test", pathItem)
        
        val detailPathItem = PathItem()
        detailPathItem.get = Operation().summary("Get").description("Retrieve a single resource")
        detailPathItem.put = Operation().summary("Update").description("Update an existing resource")
        detailPathItem.delete = Operation().summary("Delete").description("Delete a resource")
        paths.addPathItem("/test/{id}", detailPathItem)
        
        openAPI.paths = paths
        
        // Verify paths exist
        assertNotNull(openAPI.paths["/test"]?.get)
        assertNotNull(openAPI.paths["/test"]?.post)
        assertNotNull(openAPI.paths["/test/{id}"]?.get)
        assertNotNull(openAPI.paths["/test/{id}"]?.put)
        assertNotNull(openAPI.paths["/test/{id}"]?.delete)
    }

    @Test
    fun `OpenAPI info can be customized`() {
        val customProps = OpenApiProperties(
            enabled = true,
            title = "Custom API",
            description = "Custom Description",
            version = "2.0.0"
        )
        val customOpenAPI = config.customOpenAPI(customProps)
        
        assertEquals("Custom API", customOpenAPI.info.title)
        assertEquals("Custom Description", customOpenAPI.info.description)
        assertEquals("2.0.0", customOpenAPI.info.version)
    }

    // ============================================================
    // CRUD Operations Enhancement Tests
    // ============================================================

    @Test
    fun `enhanceCrudOperations should enhance all CRUD endpoints`() {
        // Setup paths for a basic controller - simulating what SpringDoc would generate
        val paths = Paths()
        paths.addPathItem("/api/users", PathItem()
            .get(Operation())
            .post(Operation())
        )
        paths.addPathItem("/api/users/{id}", PathItem()
            .get(Operation())
            .put(Operation())
            .delete(Operation())
        )
        openAPI.paths = paths

        // Create a mock controller that mimics what enhanceControllerPaths would process
        // We test this indirectly by calling the customizer with an empty list
        // and manually verifying the path structure
        
        // Manually simulate what enhanceCrudOperations would do
        val indexOp = paths["/api/users"]?.get
        indexOp?.summary = "List users"
        indexOp?.description = "Retrieve a list of users with pagination support"
        indexOp?.operationId = "indexUsers"
        
        val storeOp = paths["/api/users"]?.post
        storeOp?.summary = "Create user"
        storeOp?.operationId = "createUser"
        
        val showOp = paths["/api/users/{id}"]?.get
        showOp?.summary = "Get user"
        showOp?.operationId = "getUser"
        
        val updateOp = paths["/api/users/{id}"]?.put
        updateOp?.summary = "Update user"
        updateOp?.operationId = "updateUser"
        
        val deleteOp = paths["/api/users/{id}"]?.delete
        deleteOp?.summary = "Delete user"
        deleteOp?.operationId = "deleteUser"

        // Verify the operations are set up correctly
        assertNotNull(indexOp)
        assertEquals("List users", indexOp.summary)
        assertTrue(indexOp.description?.contains("pagination") ?: false)
        assertEquals("indexUsers", indexOp.operationId)

        assertNotNull(storeOp)
        assertEquals("Create user", storeOp.summary)
        assertEquals("createUser", storeOp.operationId)

        assertNotNull(showOp)
        assertEquals("Get user", showOp.summary)
        assertEquals("getUser", showOp.operationId)

        assertNotNull(updateOp)
        assertEquals("Update user", updateOp.summary)
        assertEquals("updateUser", updateOp.operationId)

        assertNotNull(deleteOp)
        assertEquals("Delete user", deleteOp.summary)
        assertEquals("deleteUser", deleteOp.operationId)
    }

    @Test
    fun `pagination parameters should have correct schema and defaults`() {
        val operation = Operation()
        
        // Simulate adding pagination parameters
        val pageSchema = Schema<Int>()
        pageSchema.setType("integer")
        pageSchema.setDefault(0)
        
        val pageParam = Parameter()
            .name("page")
            .`in`("query")
            .description("Page number (0-indexed)")
            .required(false)
            .schema(pageSchema)
        
        val sizeSchema = Schema<Int>()
        sizeSchema.setType("integer")
        sizeSchema.setDefault(20)
        
        val sizeParam = Parameter()
            .name("size")
            .`in`("query")
            .description("Number of items per page")
            .required(false)
            .schema(sizeSchema)
        
        val sortSchema = Schema<String>()
        sortSchema.setType("string")
        
        val sortParam = Parameter()
            .name("sort")
            .`in`("query")
            .description("Sort criteria in the format: property(,asc|desc). Default sort order is ascending.")
            .required(false)
            .schema(sortSchema)
        
        operation.addParametersItem(pageParam)
        operation.addParametersItem(sizeParam)
        operation.addParametersItem(sortParam)

        // Verify pagination parameters
        val page = operation.parameters.find { it.name == "page" }
        assertNotNull(page)
        assertEquals("query", page.`in`)
        assertEquals("integer", page.schema.type)
        assertEquals(0, page.schema.default)
        assertEquals(false, page.required)

        val size = operation.parameters.find { it.name == "size" }
        assertNotNull(size)
        assertEquals("query", size.`in`)
        assertEquals("integer", size.schema.type)
        assertEquals(20, size.schema.default)

        val sort = operation.parameters.find { it.name == "sort" }
        assertNotNull(sort)
        assertEquals("query", sort.`in`)
        assertEquals("string", sort.schema.type)
        assertTrue(sort.description?.contains("property") ?: false)
    }

    // ============================================================
    // Bulk Operations Enhancement Tests
    // ============================================================

    @Test
    fun `enhanceBulkOperations should enhance bulk endpoints when controller implements BulkOperationsMarker`() {
        val paths = Paths()
        paths.addPathItem("/api/products/bulk", PathItem()
            .post(Operation())
            .put(Operation())
            .delete(Operation())
        )
        openAPI.paths = paths

        val controller = BulkTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        // Verify bulk create
        val bulkCreateOp = openAPI.paths["/api/products/bulk"]?.post
        assertNotNull(bulkCreateOp)
        assertEquals("Bulk create products", bulkCreateOp.summary)
        assertTrue(bulkCreateOp.description?.contains("multiple") ?: false)
        assertEquals("bulkCreateProduct", bulkCreateOp.operationId)

        // Verify bulk update
        val bulkUpdateOp = openAPI.paths["/api/products/bulk"]?.put
        assertNotNull(bulkUpdateOp)
        assertEquals("Bulk update products", bulkUpdateOp.summary)
        assertEquals("bulkUpdateProduct", bulkUpdateOp.operationId)

        // Verify bulk delete
        val bulkDeleteOp = openAPI.paths["/api/products/bulk"]?.delete
        assertNotNull(bulkDeleteOp)
        assertEquals("Bulk delete products", bulkDeleteOp.summary)
        assertEquals("bulkDeleteProduct", bulkDeleteOp.operationId)
    }

    @Test
    fun `bulk operations should not be enhanced for non-bulk controllers`() {
        val paths = Paths()
        paths.addPathItem("/api/users/bulk", PathItem()
            .post(Operation().summary("Original"))
        )
        openAPI.paths = paths

        val controller = BasicTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        // Should not enhance since controller doesn't implement BulkOperationsMarker
        val bulkOp = openAPI.paths["/api/users/bulk"]?.post
        assertNotNull(bulkOp)
        // Summary should remain original since enhancement shouldn't happen
        assertEquals("Original", bulkOp.summary)
    }

    // ============================================================
    // Soft Delete Operations Enhancement Tests
    // ============================================================

    @Test
    fun `enhanceSoftDeleteOperations should enhance soft delete endpoints when controller implements SoftDeletableMarker`() {
        val paths = Paths()
        paths.addPathItem("/api/orders/{id}/soft-delete", PathItem()
            .delete(Operation())
        )
        paths.addPathItem("/api/orders/{id}/restore", PathItem()
            .put(Operation())
        )
        paths.addPathItem("/api/orders/{id}/force", PathItem()
            .delete(Operation())
        )
        openAPI.paths = paths

        val controller = SoftDeletableTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        // Verify soft delete
        val softDeleteOp = openAPI.paths["/api/orders/{id}/soft-delete"]?.delete
        assertNotNull(softDeleteOp)
        assertEquals("Soft delete order", softDeleteOp.summary)
        assertTrue(softDeleteOp.description?.contains("can be restored") ?: false)
        assertEquals("softDeleteOrder", softDeleteOp.operationId)

        // Verify restore
        val restoreOp = openAPI.paths["/api/orders/{id}/restore"]?.put
        assertNotNull(restoreOp)
        assertEquals("Restore order", restoreOp.summary)
        assertTrue(restoreOp.description?.contains("soft-deleted") ?: false)
        assertEquals("restoreOrder", restoreOp.operationId)

        // Verify force delete
        val forceDeleteOp = openAPI.paths["/api/orders/{id}/force"]?.delete
        assertNotNull(forceDeleteOp)
        assertEquals("Force delete order", forceDeleteOp.summary)
        assertTrue(forceDeleteOp.description?.contains("Permanently") ?: false)
        assertEquals("forceDeleteOrder", forceDeleteOp.operationId)
    }

    @Test
    fun `soft delete operations should not be enhanced for non-soft-deletable controllers`() {
        val paths = Paths()
        paths.addPathItem("/api/users/{id}/soft-delete", PathItem()
            .delete(Operation().summary("Original"))
        )
        openAPI.paths = paths

        val controller = BasicTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        // Should not enhance since controller doesn't implement SoftDeletableMarker
        val softDeleteOp = openAPI.paths["/api/users/{id}/soft-delete"]?.delete
        assertNotNull(softDeleteOp)
        assertEquals("Original", softDeleteOp.summary)
    }

    @Test
    fun `controller with both markers should enhance both bulk and soft delete operations`() {
        val paths = Paths()
        paths.addPathItem("/api/items/bulk", PathItem().post(Operation()))
        paths.addPathItem("/api/items/{id}/soft-delete", PathItem().delete(Operation()))
        openAPI.paths = paths

        val controller = FullFeaturedTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        // Verify bulk operation is enhanced
        val bulkOp = openAPI.paths["/api/items/bulk"]?.post
        assertNotNull(bulkOp)
        assertEquals("Bulk create items", bulkOp.summary)

        // Verify soft delete operation is enhanced
        val softDeleteOp = openAPI.paths["/api/items/{id}/soft-delete"]?.delete
        assertNotNull(softDeleteOp)
        assertEquals("Soft delete item", softDeleteOp.summary)
    }

    // ============================================================
    // Versioning and Deprecation Tests
    // ============================================================

    @Test
    fun `operation IDs should be prefixed with version when ApiVersion annotation is present`() {
        val paths = Paths()
        paths.addPathItem("/api/versioned", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller = VersionedTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        val indexOp = openAPI.paths["/api/versioned"]?.get
        assertNotNull(indexOp)
        assertEquals("v1_indexVersioned", indexOp.operationId)
    }

    @Test
    fun `deprecated endpoints should be marked with deprecation notice`() {
        val paths = Paths()
        paths.addPathItem("/api/deprecated", PathItem()
            .get(Operation().description("Original description"))
        )
        openAPI.paths = paths

        val controller = DeprecatedTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        val indexOp = openAPI.paths["/api/deprecated"]?.get
        assertNotNull(indexOp)
        assertTrue(indexOp.deprecated)
        assertTrue(indexOp.description?.contains("DEPRECATED") ?: false)
        assertTrue(indexOp.description?.contains("2026-12-31") ?: false)
        assertTrue(indexOp.description?.contains("migration guide") ?: false)
        assertTrue(indexOp.description?.contains("https://docs.example.com/migration") ?: false)
        assertTrue(indexOp.description?.contains("Original description") ?: false)
    }

    @Test
    fun `deprecated endpoints without sunset date should still be marked`() {
        @ApiVersion(value = "v1", deprecated = true)
        class DeprecatedNoSunsetController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
            service = TestService(),
            needAuthorization = false,
            basePackage = "io.github.robertomike.super_controller"
        ) {
            init {
                path = "nosunset"
            }
        }

        val paths = Paths()
        paths.addPathItem("/api/nosunset", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller = DeprecatedNoSunsetController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        val indexOp = openAPI.paths["/api/nosunset"]?.get
        assertNotNull(indexOp)
        assertTrue(indexOp.deprecated)
        assertTrue(indexOp.description?.contains("DEPRECATED") ?: false)
    }

    // ============================================================
    // Annotation Handling Tests
    // ============================================================

    @Test
    fun `controller with SuperControllerOpenApi annotation should use custom tags`() {
        val paths = Paths()
        paths.addPathItem("/api/annotated", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller = AnnotatedTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        val indexOp = openAPI.paths["/api/annotated"]?.get
        assertNotNull(indexOp)
        assertNotNull(indexOp.tags)
        assertTrue(indexOp.tags.contains("CustomTag"))
        assertTrue(indexOp.tags.contains("AnotherTag"))
    }

    @Test
    fun `controller without annotation should use default resource name as tag`() {
        val paths = Paths()
        paths.addPathItem("/api/users", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller = BasicTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        val indexOp = openAPI.paths["/api/users"]?.get
        assertNotNull(indexOp)
        assertNotNull(indexOp.tags)
        assertTrue(indexOp.tags.contains("Users"))
    }

    // ============================================================
    // Edge Cases and Multiple Controllers
    // ============================================================

    @Test
    fun `multiple controllers should all be enhanced`() {
        val paths = Paths()
        paths.addPathItem("/api/users", PathItem().get(Operation()))
        paths.addPathItem("/api/products", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller1 = BasicTestController()
        val controller2 = BulkTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller1, controller2))
        customizer.customise(openAPI)

        val usersOp = openAPI.paths["/api/users"]?.get
        assertNotNull(usersOp)
        assertEquals("List users", usersOp.summary)

        val productsOp = openAPI.paths["/api/products"]?.get
        assertNotNull(productsOp)
        assertEquals("List products", productsOp.summary)
    }

    @Test
    fun `controller with non-standard resource name should handle singular correctly`() {
        class DataController : SuperController<TestEntity, Long, TestRequest, TestUpdateRequest>(
            service = TestService(),
            needAuthorization = false,
            basePackage = "io.github.robertomike.super_controller"
        ) {
            init {
                path = "data" // doesn't end with 's'
            }
        }

        val paths = Paths()
        paths.addPathItem("/api/data/{id}", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller = DataController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        customizer.customise(openAPI)

        val showOp = openAPI.paths["/api/data/{id}"]?.get
        assertNotNull(showOp)
        assertEquals("Get data", showOp.summary) // Should use 'data' as singular
    }

    @Test
    fun `customizer should handle null paths gracefully`() {
        openAPI.paths = null

        val controller = BasicTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        
        // Should not throw exception
        try {
            customizer.customise(openAPI)
            // Success - no exception thrown
            assertTrue(true)
        } catch (e: Exception) {
            fail("Should not throw exception when paths is null: ${e.message}")
        }
    }

    @Test
    fun `pagination parameters should not be duplicated on repeated customization`() {
        val paths = Paths()
        paths.addPathItem("/api/users", PathItem().get(Operation()))
        openAPI.paths = paths

        val controller = BasicTestController()
        val customizer = config.superControllerOpenApiCustomizer(listOf(controller))
        
        // Apply customization twice
        customizer.customise(openAPI)
        customizer.customise(openAPI)

        val indexOp = openAPI.paths["/api/users"]?.get
        assertNotNull(indexOp)
        
        // Count pagination parameters - should be exactly 3
        val pageParams = indexOp.parameters.count { it.name == "page" }
        val sizeParams = indexOp.parameters.count { it.name == "size" }
        val sortParams = indexOp.parameters.count { it.name == "sort" }
        
        assertEquals(1, pageParams, "page parameter should not be duplicated")
        assertEquals(1, sizeParams, "size parameter should not be duplicated")
        assertEquals(1, sortParams, "sort parameter should not be duplicated")
    }
}
